# Public site URL
NEXT_PUBLIC_APP_URL=https://mendhaus.shop

# Flip to 1 only after Stripe + webhook + Supabase + supplier mapping are real
NEXT_PUBLIC_MENDHAUS_CHECKOUT=0

# Stripe (restricted key preferred). Owner creates the account.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Set to 1 only after Stripe Tax registrations exist for your nexus
MENDHAUS_STRIPE_TAX=0

# Dedicated Mendhaus Supabase project (do not reuse TributeReady memorial DB)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Transactional email (Resend). Free plan = 1 verified domain.
# Until mendhaus.shop is added (upgrade Resend), send via tributeready.org:
RESEND_API_KEY=
RESEND_FROM_EMAIL=Mendhaus <delivery@tributeready.org>
RESEND_REPLY_TO=care@mendhaus.shop
MENDHAUS_OWNER_EMAIL=care@mendhaus.shop

# Owner / cron
CRON_SECRET=
OWNER_DASHBOARD_TOKEN=

# Set to 1 only after CJ/Spocket accounts exist and live SKUs are mapped
MENDHAUS_SUPPLIER_READY=0

# CJ Dropshipping (https://cjdropshipping.com → Authorization → API)
# Prefer CJ_ACCESS_TOKEN from getAccessToken; or CJ_API_KEY (optional CJ_EMAIL)
CJ_ACCESS_TOKEN=
CJ_REFRESH_TOKEN=
CJ_EMAIL=
CJ_API_KEY=

# IndexNow key file must be hosted at /$MENDHAUS_INDEXNOW_KEY.txt
MENDHAUS_INDEXNOW_KEY=

# Optional file ledger fallback
REVENUEOS_LEDGER_DIR=
MAX_AUTONOMOUS_DAILY_COST_USD=0
