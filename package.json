{
  "name": "tributeready",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test tests/*.test.ts",
    "operator:dev": "npm --workspace @revenueos/operator-service run dev",
    "operator:start": "npm --workspace @revenueos/operator-service run start",
    "operator:deploy": "npm --workspace @revenueos/operator-service run deploy",
    "operator:test": "npm --workspace @revenueos/operator-service run test",
    "hosting:start": "npm --workspace @revenueos/hosting-plane run start",
    "hosting:dev": "npm --workspace @revenueos/hosting-plane run dev",
    "sidecar:start": "npm --workspace @revenueos/browser-sidecar run start",
    "sidecar:dev": "npm --workspace @revenueos/browser-sidecar run dev",
    "sidecar:cli": "npm --workspace @revenueos/browser-sidecar run cli --",
    "sidecar:test": "SKIP_PLAYWRIGHT_INSTALL=1 npm --workspace @revenueos/browser-sidecar run test",
    "dashboard:dev": "npm --workspace @portfolio/dashboard run dev",
    "dashboard:build": "npm --workspace @portfolio/dashboard run build",
    "dashboard:start": "npm --workspace @portfolio/dashboard run start",
    "revenueos": "npm --workspace @revenueos/infra run cli --",
    "db": "npm --workspace @revenueos/infra run cli -- db",
    "test:data": "tsx --test packages/revenueos-data/src/health.test.ts",
    "test:infra": "tsx --test services/revenueos-infra/src/tests/*.test.ts"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.5.1",
    "@revenueos/core": "file:packages/revenueos",
    "@revenueos/storefront-kit": "file:packages/storefront-kit",
    "@supabase/supabase-js": "^2.109.0",
    "@types/archiver": "^8.0.0",
    "archiver": "^8.0.0",
    "docx": "^9.7.1",
    "lucide-react": "^1.29.0",
    "next": "16.3.0",
    "openai": "^6.49.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.18.1",
    "stripe": "^22.4.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.10",
    "typescript": "^5"
  }
}
