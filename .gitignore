# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/services/*/node_modules
/apps/*/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/apps/*/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.revenueos-platform.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

data/revenueos/ledger.json
.env.portfolio

# Persistent operator + sidecar local state
/.data/
services/browser-sidecar/screenshots/

.env.revenueos-platform
services/operator/.env
