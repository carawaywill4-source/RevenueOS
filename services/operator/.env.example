# Copy to services/operator/.env (gitignored) or rely on repo .env.portfolio.
# Defaults below are safe for Mac shadow testing — Vercel stays owner.

OPERATOR_NAME=mac-revenueos-core
PORT=8080

# Required — same project as production portfolio memory
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cutover knobs (keep these until claims migration is verified)
SHADOW_MODE=1
CLAIM_ENABLED=0

# Start with ONE low-risk digital business
BUSINESSES=raiseready

MAX_CONCURRENCY=1
PER_BUSINESS_MIN_INTERVAL_MS=60000
TICK_BUDGET_MS=120000
MAX_JOBS_PER_TICK=8
CLAIM_LEASE_MS=300000

# Optional — required for real commercial actions after shadow
# SIDECAR_URL=http://127.0.0.1:8787
# SIDECAR_TOKEN=
# SIDECAR_DRY_RUN=1
# OPENAI_API_KEY=
# RESEND_API_KEY=
# STRIPE_SECRET_KEY=
