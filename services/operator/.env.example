# Persistent operator service — env schema.
# Copy to .env for local `pnpm dev`. On Fly.io use `fly secrets set`.

# Boot identity
OPERATOR_NAME=operator-local
PORT=8080
NODE_ENV=development

# Supabase — the operator writes pursuit events and reads observation state
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Browser sidecar — required for external distribution actions
SIDECAR_URL=http://localhost:7071
SIDECAR_TOKEN=change-me
# Set 1 to draft-and-preview instead of publishing
SIDECAR_DRY_RUN=1

# Portfolio bandwidth
MAX_CONCURRENCY=3
PER_BUSINESS_MIN_INTERVAL_MS=30000
TICK_BUDGET_MS=180000
MAX_JOBS_PER_TICK=24

# Operator claim lease (ms) — cron falls back if this expires
CLAIM_LEASE_MS=300000

# Optional filter — e.g. BUSINESSES=raiseready,ledgerleaf
BUSINESSES=

# Shared portfolio LLM credentials (optional for local dev)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
REVENUEOS_STRATEGIST_MODEL=gpt-4o
RESEND_API_KEY=
