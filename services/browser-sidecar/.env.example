# Local browser sidecar — .env
# Copy this to .env before `npm run dev`.

# Shared secret with the operator service. Any 16+ random chars.
SIDECAR_TOKEN=

# HTTP bind port
PORT=7071

# Draft-and-preview mode: filled forms + screenshot, no submit
# Set to 0 once you've reviewed a few dry-run screenshots.
DRY_RUN=1

# Chromium user profile directory. Cookies + localStorage persist here.
# Default: ~/.revenueos-sidecar/chromium
# PROFILE_DIR=

# Screenshot output directory. Default: ~/.revenueos-sidecar/screenshots
# SCREENSHOT_DIR=

# Run Chromium headless. Recommended false for interactive posting.
HEADLESS=0

# Default daily action cap (per-platform overrides are in code).
DAILY_ACTION_CAP=20
