{
  "name": "@revenueos/browser-sidecar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local Playwright sidecar that lets the operator publish via the owner's real browser sessions.",
  "bin": {
    "sidecar": "src/cli.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "cli": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test src/tests/*.test.ts",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "dependencies": {
    "express": "^4.19.2",
    "playwright": "^1.47.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20",
    "tsx": "^4.23.10",
    "typescript": "^5"
  }
}
